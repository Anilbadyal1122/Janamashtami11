<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Janmashtami</title>

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #03040a;
    }

    body {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    canvas {
        display: block;
        width: 100vw;
        height: 100vh;
        object-fit: contain;
        background: #03040a;
    }

    #startButton {
        position: fixed;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);

        padding: 15px 30px;

        border: 1px solid rgba(255, 220, 120, 0.8);
        border-radius: 30px;

        background: rgba(20, 12, 5, 0.85);
        color: #ffe9a8;

        font-size: 18px;
        font-family: Georgia, serif;

        cursor: pointer;

        box-shadow:
            0 0 25px rgba(255, 190, 60, 0.4);

        z-index: 10;
    }

    #startButton:hover {
        background: rgba(60, 35, 10, 0.9);
    }
</style>
</head>

<body>

<canvas id="canvas" width="1000" height="700"></canvas>

<button id="startButton">
    ✨ Begin Janmashtami ✨
</button>

<audio id="music" src="janmashtami_music.mp3"></audio>


<script>

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

const WIDTH = 1000;
const HEIGHT = 700;

const TOTAL_TIME = 24;

const photo1 = new Image();
const photo2 = new Image();

photo1.src = "krishna1.jpg";
photo2.src = "krishna2.jpg";

const music = document.getElementById("music");
const startButton = document.getElementById("startButton");


// =========================================================
// RANDOM
// =========================================================

function random(min, max) {
    return Math.random() * (max - min) + min;
}


// =========================================================
// EASING
// =========================================================

function ease(t) {

    t = Math.max(0, Math.min(1, t));

    return t * t * (3 - 2 * t);
}


// =========================================================
// STARS
// =========================================================

const stars = [];

for (let i = 0; i < 90; i++) {

    stars.push({
        x: random(0, WIDTH),
        y: random(0, HEIGHT),
        size: random(0.5, 1.8),
        phase: random(0, Math.PI * 2)
    });
}


// =========================================================
// PARTICLES
// =========================================================

const particles = [];

for (let i = 0; i < 65; i++) {

    particles.push({

        x: random(0, WIDTH),

        y: random(0, HEIGHT),

        speed: random(8, 25),

        size: random(1, 3),

        phase: random(
            0,
            Math.PI * 2
        )
    });
}


// =========================================================
// BACKGROUND
// =========================================================

function createBackground() {

    const gradient =
        ctx.createLinearGradient(
            0,
            0,
            0,
            HEIGHT
        );

    gradient.addColorStop(
        0,
        "#03040a"
    );

    gradient.addColorStop(
        1,
        "#0d1024"
    );

    ctx.fillStyle = gradient;

    ctx.fillRect(
        0,
        0,
        WIDTH,
        HEIGHT
    );
}


// =========================================================
// STARS
// =========================================================

function drawStars(time) {

    for (const star of stars) {

        const brightness =
            (
                Math.sin(
                    time * 2 +
                    star.phase
                ) + 1
            ) / 2;

        const alpha =
            0.25 +
            brightness * 0.7;

        ctx.beginPath();

        ctx.arc(
            star.x,
            star.y,
            Math.max(
                1,
                star.size
            ),
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            `rgba(255,230,150,${alpha})`;

        ctx.fill();
    }
}


// =========================================================
// PARTICLES
// =========================================================

function drawParticles(
    time,
    strength = 1
) {

    for (const p of particles) {

        const x =
            p.x +
            Math.sin(
                time * 1.2 +
                p.phase
            ) * 18;

        const y =
            (
                p.y -
                time * p.speed
            ) % HEIGHT;

        const pulse =
            (
                Math.sin(
                    time * 2 +
                    p.phase
                ) + 1
            ) / 2;

        const alpha =
            (
                0.2 +
                pulse * 0.6
            ) * strength;

        ctx.beginPath();

        ctx.arc(
            x,
            y,
            p.size,
            0,
            Math.PI * 2
        );

        ctx.fillStyle =
            `rgba(255,207,80,${alpha})`;

        ctx.fill();
    }
}


// =========================================================
// DIVINE GLOW
// =========================================================

function divineGlow(strength = 1) {

    const gradient =
        ctx.createRadialGradient(
            WIDTH / 2,
            HEIGHT / 2,
            20,
            WIDTH / 2,
            HEIGHT / 2,
            550
        );

    gradient.addColorStop(
        0,
        `rgba(255,190,60,${0.10 * strength})`
    );

    gradient.addColorStop(
        0.45,
        `rgba(255,160,30,${0.035 * strength})`
    );

    gradient.addColorStop(
        1,
        "rgba(0,0,0,0)"
    );

    ctx.fillStyle = gradient;

    ctx.fillRect(
        0,
        0,
        WIDTH,
        HEIGHT
    );
}


// =========================================================
// GOLDEN RAYS
// =========================================================

function goldenRays(
    time,
    strength = 1
) {

    const cx = WIDTH / 2;
    const cy = HEIGHT / 2;

    ctx.save();

    ctx.translate(
        cx,
        cy
    );

    for (let i = 0; i < 18; i++) {

        const angle =
            i *
            (
                Math.PI * 2 / 18
            )
            +
            time * 0.08;

        const length = 850;

        const x =
            Math.cos(angle) *
            length;

        const y =
            Math.sin(angle) *
            length;

        ctx.beginPath();

        ctx.moveTo(
            0,
            0
        );

        ctx.lineTo(
            x,
            y
        );

        ctx.strokeStyle =
            `rgba(255,205,90,${0.08 * strength})`;

        ctx.lineWidth = 2;

        ctx.stroke();
    }

    ctx.restore();
}


// =========================================================
// ENERGY RINGS
// =========================================================

function energyRings(
    time,
    strength = 1
) {

    const cx = WIDTH / 2;
    const cy = HEIGHT / 2;

    for (let i = 0; i < 4; i++) {

        const radius =
            80 +
            (
                (
                    time * 70 +
                    i * 100
                ) % 450
            );

        const alpha =
            Math.max(
                0,
                0.20 *
                strength *
                (
                    1 -
                    radius / 550
                )
            );

        ctx.beginPath();

        ctx.arc(
            cx,
            cy,
            radius,
            0,
            Math.PI * 2
        );

        ctx.strokeStyle =
            `rgba(255,200,70,${alpha})`;

        ctx.lineWidth = 2;

        ctx.stroke();
    }
}


// =========================================================
// LIGHT SWEEP
// =========================================================

function lightSweep(progress) {

    const x =
        -500 +
        progress *
        (
            WIDTH + 1000
        );

    const gradient =
        ctx.createLinearGradient(
            x - 200,
            0,
            x + 200,
            0
        );

    gradient.addColorStop(
        0,
        "rgba(255,220,120,0)"
    );

    gradient.addColorStop(
        0.5,
        "rgba(255,235,160,0.35)"
    );

    gradient.addColorStop(
        1,
        "rgba(255,220,120,0)"
    );

    ctx.save();

    ctx.translate(
        0,
        0
    );

    ctx.transform(
        1,
        0,
        -0.4,
        1,
        0,
        0
    );

    ctx.fillStyle = gradient;

    ctx.fillRect(
        x - 150,
        -100,
        300,
        HEIGHT + 200
    );

    ctx.restore();
}


// =========================================================
// DRAW IMAGE WITHOUT CROPPING
// =========================================================

function drawImageFit(
    image,
    alpha = 1
) {

    const iw = image.naturalWidth;
    const ih = image.naturalHeight;

    if (!iw || !ih) {
        return;
    }

    const scale =
        Math.min(
            WIDTH / iw,
            HEIGHT / ih
        );

    const nw =
        iw * scale;

    const nh =
        ih * scale;

    const x =
        (WIDTH - nw) / 2;

    const y =
        (HEIGHT - nh) / 2;

    ctx.save();

    ctx.globalAlpha =
        alpha;

    ctx.drawImage(
        image,
        x,
        y,
        nw,
        nh
    );

    ctx.restore();
}


// =========================================================
// FINAL TEXT
// =========================================================

function drawWish(
    progress
) {

    const alpha =
        ease(progress);

    divineGlow(
        0.8 +
        progress * 0.4
    );

    const text =
        "Wish You a Happy Janmashtami";

    ctx.save();

    ctx.globalAlpha =
        alpha;

    ctx.textAlign =
        "center";

    ctx.textBaseline =
        "middle";

    ctx.font =
        "62px Georgia, serif";

    // Glow
    ctx.shadowColor =
        "rgba(255,190,60,0.9)";

    ctx.shadowBlur =
        25;

    ctx.fillStyle =
        "#ffeda8";

    ctx.fillText(
        text,
        WIDTH / 2,
        540
    );

    // Main text
    ctx.shadowBlur = 5;

    ctx.fillStyle =
        "#ffe9a8";

    ctx.strokeStyle =
        "#825514";

    ctx.lineWidth = 2;

    ctx.strokeText(
        text,
        WIDTH / 2,
        540
    );

    ctx.fillText(
        text,
        WIDTH / 2,
        540
    );

    // Decorative line
    ctx.beginPath();

    ctx.moveTo(
        WIDTH / 2 - 250,
        590
    );

    ctx.lineTo(
        WIDTH / 2 + 250,
        590
    );

    ctx.strokeStyle =
        "rgba(225,175,70,0.8)";

    ctx.lineWidth = 2;

    ctx.stroke();

    // Diamond
    const cx =
        WIDTH / 2;

    ctx.beginPath();

    ctx.moveTo(
        cx,
        583
    );

    ctx.lineTo(
        cx + 7,
        590
    );

    ctx.lineTo(
        cx,
        597
    );

    ctx.lineTo(
        cx - 7,
        590
    );

    ctx.closePath();

    ctx.fillStyle =
        "#ffdc78";

    ctx.fill();

    ctx.restore();
}


// =========================================================
// ANIMATION
// =========================================================

let startTime = null;
let running = false;


function animate(timestamp) {

    if (!running) {
        return;
    }

    if (startTime === null) {
        startTime = timestamp;
    }

    const elapsed =
        (timestamp - startTime) /
        1000;

    createBackground();

    drawStars(
        elapsed
    );

    divineGlow(
        0.7
    );


    // =====================================================
    // 0 - 2 SEC
    // DARK DIVINE INTRO
    // =====================================================

    if (elapsed < 2) {

        const p =
            elapsed / 2;

        goldenRays(
            elapsed,
            p
        );

        drawParticles(
            elapsed,
            p
        );
    }


    // =====================================================
    // 2 - 9 SEC
    // FIRST KRISHNA
    // =====================================================

    else if (elapsed < 9) {

        const p =
            (elapsed - 2) / 7;

        const fade =
            Math.min(
                1,
                p * 3
            );

        drawImageFit(
            photo1,
            fade
        );

        drawParticles(
            elapsed,
            0.8
        );

        goldenRays(
            elapsed,
            0.45
        );
    }


    // =====================================================
    // 9 - 12 SEC
    // GOLDEN TRANSITION
    // =====================================================

    else if (elapsed < 12) {

        const p =
            (elapsed - 9) / 3;

        const oldAlpha =
            1 -
            ease(p);

        const newAlpha =
            ease(p);

        drawImageFit(
            photo1,
            oldAlpha
        );

        drawImageFit(
            photo2,
            newAlpha
        );

        goldenRays(
            elapsed,
            1.4
        );

        energyRings(
            elapsed,
            1.4
        );

        lightSweep(
            p
        );

        drawParticles(
            elapsed,
            1.6
        );
    }


    // =====================================================
    // 12 - 19 SEC
    // SECOND KRISHNA
    // =====================================================

    else if (elapsed < 19) {

        const p =
            (elapsed - 12) / 7;

        const fade =
            Math.min(
                1,
                p * 3
            );

        drawImageFit(
            photo2,
            fade
        );

        drawParticles(
            elapsed,
            0.9
        );

        goldenRays(
            elapsed,
            0.5
        );
    }


    // =====================================================
    // 19 - 22 SEC
    // FINAL WISH
    // =====================================================

    else if (elapsed < 22) {

        const p =
            (elapsed - 19) / 3;

        drawImageFit(
            photo2,
            1
        );

        // Dark overlay
        ctx.fillStyle =
            "rgba(0,0,0,0.35)";

        ctx.fillRect(
            0,
            0,
            WIDTH,
            HEIGHT
        );

        drawParticles(
            elapsed,
            0.8
        );

        goldenRays(
            elapsed,
            0.6
        );

        drawWish(
            p
        );
    }


    // =====================================================
    // 22 - 24 SEC
    // HOLD FINAL SCREEN
    // =====================================================

    else {

        drawImageFit(
            photo2,
            1
        );

        ctx.fillStyle =
            "rgba(0,0,0,0.35)";

        ctx.fillRect(
            0,
            0,
            WIDTH,
            HEIGHT
        );

        drawParticles(
            elapsed,
            0.7
        );

        goldenRays(
            elapsed,
            0.55
        );

        drawWish(
            1
        );
    }


    // =====================================================
    // END
    // =====================================================

    if (elapsed >= TOTAL_TIME) {

        running = false;

        music.pause();

        return;
    }


    requestAnimationFrame(
        animate
    );
}


// =========================================================
// START BUTTON
// =========================================================

startButton.addEventListener(
    "click",
    () => {

        startButton.style.display =
            "none";

        music.currentTime = 0;

        music.volume = 0.85;

        music.play().catch(
            error => {
                console.log(
                    "Music error:",
                    error
                );
            }
        );

        startTime = null;

        running = true;

        requestAnimationFrame(
            animate
        );
    }
);


// =========================================================
// INITIAL SCREEN
// =========================================================

createBackground();

drawStars(0);

divineGlow(0.7);

</script>

</body>
</html>